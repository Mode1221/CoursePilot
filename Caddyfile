# CoursePilot 리버스 프록시 + 자동 HTTPS (Let's Encrypt).
# {$DOMAIN} 환경변수에서 도메인을 읽는다. 최초 기동 시 인증서 자동 발급.

# 공통 보안 헤더 — HTTPS 강제(HSTS), MIME 추측 금지, 다른 사이트의 iframe 삽입 금지(클릭재킹),
# 리퍼러 최소화, 쓰지 않는 브라우저 권한 차단, 서버 종류 숨김.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# 스크립트·연결 출처까지 막는 전체 CSP 는 지도 SDK 도메인을 실서버에서 확인한 뒤 넣는다.
		# 지금은 기능을 깨지 않는 항목만: 플러그인(object) 금지, <base> 로 링크 가로채기 금지(form-action 은 결제 PG 로 폼을 보낼 수 있어 제외).
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-Server
	}
}

# 프론트(Next.js)
{$DOMAIN} {
	import security_headers
	encode gzip
	reverse_proxy frontend:3000
}

# 백엔드(FastAPI + Socket.IO). WebSocket 은 Caddy 가 자동 업그레이드 처리.
api.{$DOMAIN} {
	import security_headers
	encode gzip
	reverse_proxy backend:8000
}

# 옛 도메인 → 새 도메인 영구 이전(301). 주소 뒤 경로·검색어는 그대로 붙인다.
# 주의: .env 의 DOMAIN 이 아직 coursepilot-kr.duckdns.org 이면 같은 주소 블록이 둘이 되어 Caddy 가 뜨지 않는다 —
#       DOMAIN 을 picknus.duckdns.org 로 바꾼 뒤에 배포한다(docs/DEPLOY.md "도메인 이전").
coursepilot-kr.duckdns.org {
	redir https://{$DOMAIN}{uri} 301
}

# API 는 POST 가 GET 으로 바뀌지 않게 308(영구, 메서드 유지).
api.coursepilot-kr.duckdns.org {
	redir https://api.{$DOMAIN}{uri} 308
}
