DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@localhost:5432/coursepilot
# LLM 조건 분해기 (기본: Anthropic Claude Haiku 4.5). 키 없으면 규칙 기반 폴백
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAP_PROVIDER=naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 리뷰 요약/스코어링 1순위 소스(합법). 미설정 시 Mock 폴백
GOOGLE_MAPS_API_KEY=
# SMS 인증 (NHN Cloud SMS). 미설정 시 개발용 폴백(코드 응답 노출)
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_SENDER=
# 결제 (포트원/아임포트 v1). 미설정 시 개발용 폴백(검증 생략)
PORTONE_API_KEY=
PORTONE_API_SECRET=
POINT_PRICE_KRW=1000
CORS_ORIGINS=["http://localhost:3000"]
