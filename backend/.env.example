DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@localhost:5432/coursepilot
# LLM 조건 분해기 (기본: Anthropic Claude Haiku 4.5). 키 없으면 규칙 기반 폴백
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAP_PROVIDER=naver
# 장소 발견 주 원천(무료). 카카오 디벨로퍼스 REST 키
KAKAO_REST_API_KEY=
# 네이버 개발자센터(지역·블로그 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 클라우드 플랫폼 Maps(경로). 개발자센터 키와 별개 — 없으면 위 키로 폴백
NCP_API_KEY_ID=
NCP_API_KEY=
# 영업시간(Pro)·집계 평점(Enterprise). 콜을 분리해 쓰며 월 무료 한도 안에서 동작
# 키 제한(HTTP 리퍼러/IP)과 일일 할당량 상한을 반드시 설정할 것
GOOGLE_MAPS_API_KEY=
# 공공데이터포털 키(TourAPI 관광·문화시설, KOPIS 공연·전시)
TOURAPI_SERVICE_KEY=
# LOCALDATA 인허가 CSV 디렉터리(폐업·업력). 무료·무인증, 주 1회 갱신
LOCALDATA_CSV_DIR=
# 주 1회 내려받을 LOCALDATA CSV URL 목록(JSON 배열). scripts/fetch_localdata.py 가 사용
LOCALDATA_CSV_URLS=[]
# SMS 인증 (NHN Cloud SMS). 미설정 시 개발용 폴백(코드 응답 노출)
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_SENDER=
# 결제 (포트원/아임포트 v1). 미설정 시 개발용 폴백(검증 생략)
PORTONE_API_KEY=
PORTONE_API_SECRET=
POINT_PRICE_KRW=1000
# 세션 토큰 서명 키(배포 필수). 없으면 X-User-Id 헤더만으로 인증돼 계정 도용이 가능하다
SESSION_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
