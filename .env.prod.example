# 프로덕션 배포 환경변수. `cp .env.prod.example .env` 후 값 채우고 ./deploy.sh
# 시크릿이므로 .env 는 절대 커밋하지 말 것(.gitignore 처리됨).

# ── 필수 ────────────────────────────────────────────────
DOMAIN=example.com                 # api.example.com 도 이 도메인 기준 자동 구성
POSTGRES_PASSWORD=change-me-strong  # DB 비밀번호(임의 강한 값)

# ── 선택(키 없으면 해당 기능만 폴백, 서비스는 정상 기동) ──
# LLM (조건 분해). 기본 Anthropic Haiku 4.5
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# LLM_PROVIDER=openai 일 때, 그리고 리뷰 임베딩(pgvector 의미 검색)에 필요.
# 비우면 임베딩은 해시 폴백(의미 검색 품질 없음)으로 동작한다.
OPENAI_API_KEY=

# 지도/장소 (네이버) + 평점(Google Places)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=   # 프론트 지도 렌더용(빌드 시 주입)

# 인증(SMS, NHN Cloud) / 결제(포트원 v1)
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_SENDER=
PORTONE_API_KEY=
PORTONE_API_SECRET=

# 배포 환경 표식. production 이면 기동 시 필수 설정을 점검하고
# /health/ready 가 DB 연결을 필수로 본다(로드밸런서가 미완성 인스턴스를 뺀다).
ENV=production

# 세션 토큰 서명 키. 비우면 기동을 막는다 — 없으면 X-User-Id 헤더만으로 남의 계정이 된다.
# 예: openssl rand -hex 32
SESSION_SECRET=

# IP 당 분당 요청 상한.
RATE_LIMIT_PER_MIN=60

# 관리 엔드포인트(/admin/*) 보호 토큰. 배포 시 반드시 임의의 긴 값으로 설정.
ADMIN_TOKEN=

# 임계 알림(오류율·외부 연동 폴백률) 웹훅. 슬랙/디스코드 Incoming Webhook URL.
# 비워두면 로그만 남긴다.
ALERT_WEBHOOK_URL=

# 다중 인스턴스(백엔드 2개 이상)로 늘릴 때만 설정. 비워두면 단일 프로세스로 동작.
# 예: REDIS_URL=redis://redis:6379/0
# redis 서비스는 scale 프로필에 있다: docker compose --profile scale up -d
REDIS_URL=

# DB 사용자/DB명(기본값 사용 권장)
POSTGRES_USER=coursepilot
POSTGRES_DB=coursepilot
