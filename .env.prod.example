# 프로덕션 배포 환경변수. `cp .env.prod.example .env` 후 값 채우고 ./deploy.sh
# 시크릿이므로 .env 는 절대 커밋하지 말 것(.gitignore 처리됨).

# ── 필수 ────────────────────────────────────────────────
DOMAIN=example.com                 # api.example.com 도 이 도메인 기준 자동 구성
POSTGRES_PASSWORD=change-me-strong  # DB 비밀번호(임의 강한 값)

# ── 선택(키 없으면 해당 기능만 폴백, 서비스는 정상 기동) ──
# LLM (조건 분해). 기본 Anthropic Haiku 4.5
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=

# 지도/장소 (네이버) + 평점(Google Places)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=   # 프론트 지도 렌더용(빌드 시 주입)

# 인증(SMS, NHN Cloud) / 결제(포트원 v1)
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_SENDER=
PORTONE_API_KEY=
PORTONE_API_SECRET=

# DB 사용자/DB명(기본값 사용 권장)
POSTGRES_USER=coursepilot
POSTGRES_DB=coursepilot
